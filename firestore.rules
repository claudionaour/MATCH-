rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Startup connectivity test doc
    match /test/{docId} {
      allow get: if docId == 'connection';
    }

    // ====================
    // GLOBAL PRIMITIVES
    // ====================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'naourclaudio@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isPaymentExempt() {
      return isVerified()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'isadoranaour@gmail.com',
          'naourclaudio@gmail.com',
          'verocheuquepil@gmail.com',
          'renatonaourch@gmail.com'
        ];
    }

    // ====================
    // VALIDATION BLUEPRINTS
    // ====================
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'commune', 'region', 'roles', 'activeModules', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoUrl', 'phone', 'commune', 'region', 'roles', 'activeModules', 'notificationPrefs', 'privacyConsentAt', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000))
        && (!('privacyConsentAt' in data) || (data.privacyConsentAt is string && data.privacyConsentAt.size() <= 60))
        && data.roles is list && data.roles.size() >= 1 && data.roles.size() <= 7
        && data.roles.hasOnly(['buyer', 'seller', 'mixed', 'worker', 'company', 'external_advertiser', 'registered_advertiser', 'moderator', 'admin'])
        && data.activeModules is list && data.activeModules.size() <= 3
        && data.activeModules.hasOnly(['commercial', 'employment', 'advertising'])
        && data.status in ['active', 'suspended', 'deleted'];
    }

    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'commune', 'region', 'verified', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'commune', 'region', 'verified', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.verified is bool
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1000));
    }

    function isValidBusinessProfile(data) {
      return data.keys().hasAll(['ownerId', 'businessName', 'commercialName', 'description', 'category', 'commune', 'region', 'availability', 'verified', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessName', 'commercialName', 'logoUrl', 'photos', 'description', 'category', 'commune', 'region', 'location', 'contactInfo', 'hours', 'salesTerms', 'deliveryMethods', 'availability', 'verified', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 140
        && data.commercialName is string && data.commercialName.size() >= 2 && data.commercialName.size() <= 140
        && data.description is string && data.description.size() <= 1500
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.availability in ['available', 'limited', 'unavailable']
        && data.verified is bool
        && data.status in ['active', 'paused'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['ownerId', 'itemType', 'title', 'description', 'category', 'priceCLP', 'sellerName', 'commune', 'region', 'imageUrl', 'availability', 'deliveryMethods', 'verified', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'businessId', 'itemType', 'title', 'description', 'category', 'priceCLP', 'sellerName', 'commune', 'region', 'imageUrl', 'availability', 'deliveryMethods', 'verified', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.itemType in ['product', 'service']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.description is string && data.description.size() <= 1500
        && data.category is string && data.category.size() <= 80
        && data.priceCLP is number && data.priceCLP >= 0 && data.priceCLP <= 999999999
        && data.sellerName is string && data.sellerName.size() <= 140
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.availability in ['available', 'limited', 'unavailable']
        && data.deliveryMethods is list && data.deliveryMethods.size() <= 6
        && data.verified is bool
        && data.status in ['active', 'paused', 'archived'];
    }

    function isValidPurchaseRequest(data) {
      return data.keys().hasAll(['ownerId', 'buyerName', 'title', 'description', 'category', 'minBudgetCLP', 'maxBudgetCLP', 'commune', 'region', 'urgency', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'buyerName', 'title', 'description', 'category', 'minBudgetCLP', 'maxBudgetCLP', 'commune', 'region', 'urgency', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.buyerName is string && data.buyerName.size() <= 120
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 1500
        && data.category is string && data.category.size() <= 80
        && data.minBudgetCLP is number && data.minBudgetCLP >= 0
        && data.maxBudgetCLP is number && data.maxBudgetCLP >= data.minBudgetCLP
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.urgency in ['inmediata', 'esta_semana', 'este_mes']
        && data.status in ['open', 'matched', 'closed'];
    }

    function isValidWorkerProfile(data) {
      return data.keys().hasAll(['ownerId', 'displayName', 'headline', 'profession', 'skills', 'experienceYears', 'educationLevel', 'commune', 'region', 'availability', 'preferredSchedule', 'modality', 'salaryExpectationCLP', 'showSalaryExpectation', 'allowDirectContact', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'photoUrl', 'headline', 'profession', 'trades', 'skills', 'experienceYears', 'experienceSummary', 'educationLevel', 'certifications', 'commune', 'region', 'availability', 'preferredSchedule', 'modality', 'employmentType', 'salaryExpectationCLP', 'showSalaryExpectation', 'allowDirectContact', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120
        && data.headline is string && data.headline.size() <= 160
        && data.profession is string && data.profession.size() <= 100
        && data.skills is list && data.skills.size() <= 20
        && data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 70
        && data.educationLevel in ['Basica', 'Media', 'Tecnico', 'Universitario', 'Postgrado']
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.modality in ['presencial', 'remoto', 'hibrido']
        && data.salaryExpectationCLP is number && data.salaryExpectationCLP >= 0
        && data.showSalaryExpectation is bool
        && data.allowDirectContact is bool
        && data.status in ['active', 'paused'];
    }

    function isValidWorkerPrivateCV(data) {
      return data.keys().hasAll(['ownerId', 'fullSummary', 'contactEmail', 'contactPhone', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'fullSummary', 'contactEmail', 'contactPhone', 'cvUrl', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.fullSummary is string && data.fullSummary.size() <= 3000
        && data.contactEmail is string && data.contactEmail.size() <= 200
        && data.contactPhone is string && data.contactPhone.size() <= 40
        && (!('cvUrl' in data) || (data.cvUrl is string && data.cvUrl.size() <= 1000));
    }

    function isValidCompany(data) {
      return data.keys().hasAll(['ownerId', 'legalName', 'commercialName', 'description', 'sector', 'commune', 'region', 'contactInfo', 'verified', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'legalName', 'commercialName', 'taxId', 'logoUrl', 'description', 'sector', 'commune', 'region', 'contactInfo', 'website', 'verified', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.legalName is string && data.legalName.size() >= 2 && data.legalName.size() <= 140
        && data.commercialName is string && data.commercialName.size() >= 2 && data.commercialName.size() <= 140
        && data.description is string && data.description.size() <= 1500
        && data.sector is string && data.sector.size() <= 80
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.contactInfo is string && data.contactInfo.size() <= 200
        && data.verified is bool
        && data.status in ['active', 'paused'];
    }

    function isValidJobVacancy(data) {
      return data.keys().hasAll(['ownerId', 'companyName', 'title', 'description', 'mandatorySkills', 'desiredSkills', 'minExperienceYears', 'requiredEducation', 'category', 'commune', 'region', 'modality', 'schedule', 'contractType', 'salaryMinCLP', 'salaryMaxCLP', 'verified', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'companyId', 'companyName', 'title', 'description', 'responsibilities', 'requirements', 'mandatorySkills', 'desiredSkills', 'minExperienceYears', 'requiredEducation', 'category', 'commune', 'region', 'modality', 'schedule', 'contractType', 'salaryMinCLP', 'salaryMaxCLP', 'startDate', 'expiresAt', 'verified', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.companyName is string && data.companyName.size() <= 140
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.description is string && data.description.size() <= 2000
        && data.mandatorySkills is list && data.mandatorySkills.size() <= 15
        && data.desiredSkills is list && data.desiredSkills.size() <= 15
        && data.minExperienceYears is number && data.minExperienceYears >= 0 && data.minExperienceYears <= 50
        && data.requiredEducation in ['Basica', 'Media', 'Tecnico', 'Universitario', 'Postgrado']
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.modality in ['presencial', 'remoto', 'hibrido']
        && data.salaryMinCLP is number && data.salaryMinCLP >= 0
        && data.salaryMaxCLP is number && data.salaryMaxCLP >= data.salaryMinCLP
        && data.verified is bool
        && data.status in ['active', 'paused', 'expired', 'closed'];
    }

    function isValidInteraction(data) {
      return data.keys().hasAll(['fromUid', 'toUid', 'targetId', 'targetKind', 'action', 'createdAt'])
        && data.keys().hasOnly(['fromUid', 'toUid', 'targetId', 'targetKind', 'action', 'compatibilityScore', 'createdAt'])
        && isValidId(data.fromUid)
        && isValidId(data.toUid)
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.targetKind in ['product', 'purchaseRequest', 'vacancy', 'worker']
        && data.action in ['like', 'pass', 'favorite'];
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['module', 'participantIds', 'initiatorUid', 'recipientUid', 'initiatorName', 'recipientName', 'targetId', 'targetTitle', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['module', 'participantIds', 'initiatorUid', 'recipientUid', 'initiatorName', 'recipientName', 'targetId', 'targetTitle', 'compatibilityScore', 'compatibilityExplanation', 'status', 'createdAt', 'updatedAt'])
        && data.module in ['commercial', 'employment']
        && data.participantIds is list && data.participantIds.size() == 2
        && isValidId(data.initiatorUid) && isValidId(data.recipientUid)
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.targetTitle is string && data.targetTitle.size() <= 160
        && data.status in ['active', 'blocked', 'archived'];
    }

    function isValidConversation(data) {
      return data.keys().hasAll(['matchId', 'module', 'participantIds', 'participantNames', 'targetTitle', 'lastMessage', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['matchId', 'module', 'participantIds', 'participantNames', 'targetTitle', 'lastMessage', 'lastMessageAt', 'blockedBy', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.matchId)
        && data.module in ['commercial', 'employment']
        && data.participantIds is list && data.participantIds.size() == 2
        && data.targetTitle is string && data.targetTitle.size() <= 160
        && data.lastMessage is string && data.lastMessage.size() <= 500
        && data.status in ['active', 'blocked'];
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'text', 'read', 'createdAt'])
        && data.keys().hasOnly(['senderId', 'text', 'imageUrl', 'read', 'createdAt'])
        && isValidId(data.senderId)
        && data.text is string && data.text.size() <= 2000
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && data.read is bool;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'type', 'title', 'body', 'read', 'createdAt'])
        && data.keys().hasOnly(['userId', 'type', 'title', 'body', 'module', 'relatedId', 'read', 'createdAt'])
        && isValidId(data.userId)
        && data.type is string && data.type.size() <= 40
        && data.title is string && data.title.size() <= 140
        && data.body is string && data.body.size() <= 500
        && data.read is bool;
    }

    function isValidAdvertiser(data) {
      return data.keys().hasAll(['ownerId', 'advertiserType', 'businessName', 'responsibleName', 'category', 'description', 'commune', 'region', 'contactEmail', 'contactPhone', 'discountPercent', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'advertiserType', 'businessName', 'responsibleName', 'category', 'description', 'commune', 'region', 'contactEmail', 'contactPhone', 'website', 'discountPercent', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.advertiserType in ['external', 'registered']
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 140
        && data.responsibleName is string && data.responsibleName.size() <= 120
        && data.category is string && data.category.size() <= 80
        && data.description is string && data.description.size() <= 1500
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && data.contactEmail is string && data.contactEmail.size() <= 200
        && data.contactPhone is string && data.contactPhone.size() <= 40
        && data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100
        && data.status in ['active', 'suspended'];
    }

    function isValidAdPackage(data) {
      return data.keys().hasAll(['name', 'tier', 'billingCycle', 'durationDays', 'priceCLP', 'priorityWeight', 'description', 'features', 'active', 'updatedAt'])
        && data.keys().hasOnly(['name', 'tier', 'billingCycle', 'durationDays', 'priceCLP', 'priorityWeight', 'description', 'features', 'active', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.billingCycle in ['monthly', 'temporary']
        && data.durationDays is number && data.durationDays >= 1 && data.durationDays <= 365
        && data.priceCLP is number && data.priceCLP >= 0
        && data.priorityWeight is number && data.priorityWeight >= 1 && data.priorityWeight <= 100
        && data.features is list && data.features.size() <= 10
        && data.active is bool;
    }

    function isValidAdCampaign(data) {
      return data.keys().hasAll(['ownerId', 'advertiserId', 'advertiserType', 'businessName', 'objective', 'title', 'description', 'benefit', 'ctaLabel', 'ctaActionType', 'ctaDestination', 'imageUrl', 'targetSections', 'targetCategories', 'targetScope', 'targetCommune', 'targetRegion', 'packageId', 'packageName', 'durationDays', 'basePriceCLP', 'discountCLP', 'finalAmountCLP', 'priorityWeight', 'startDate', 'endDate', 'paymentStatus', 'moderationStatus', 'impressionsCount', 'clicksCount', 'contactsCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'advertiserId', 'advertiserType', 'businessName', 'objective', 'title', 'description', 'benefit', 'offerPriceText', 'ctaLabel', 'ctaActionType', 'ctaDestination', 'imageUrl', 'logoUrl', 'targetSections', 'targetCategories', 'targetScope', 'targetCommune', 'targetRegion', 'targetAudienceNote', 'packageId', 'packageName', 'durationDays', 'basePriceCLP', 'discountCLP', 'finalAmountCLP', 'priorityWeight', 'startDate', 'endDate', 'paymentStatus', 'moderationStatus', 'rejectionReason', 'impressionsCount', 'clicksCount', 'contactsCount', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.businessName is string && data.businessName.size() <= 140
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 600
        && data.ctaLabel is string && data.ctaLabel.size() <= 60
        && data.ctaDestination is string && data.ctaDestination.size() <= 500
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.targetSections is list && data.targetSections.size() >= 1 && data.targetSections.size() <= 3
        && data.targetCategories is list && data.targetCategories.size() >= 1 && data.targetCategories.size() <= 10
        && data.targetScope in ['chiloe', 'los_lagos', 'chile']
        && data.finalAmountCLP is number && data.finalAmountCLP >= 0
        && data.paymentStatus in ['pending_payment', 'pending_confirmation', 'confirmed', 'rejected', 'cancelled', 'expired']
        && data.moderationStatus in ['draft', 'pending_review', 'approved', 'rejected', 'active', 'paused', 'finished', 'cancelled']
        && data.impressionsCount is number && data.impressionsCount >= 0
        && data.clicksCount is number && data.clicksCount >= 0
        && data.contactsCount is number && data.contactsCount >= 0;
    }

    function isValidAdDraft(data) {
      return data.keys().hasAll(['ownerId', 'step', 'payload', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'step', 'payload', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.step is number && data.step >= 1 && data.step <= 10
        && data.payload is map;
    }

    function isValidAdOrder(data) {
      return data.keys().hasAll(['ownerId', 'engine', 'orderType', 'description', 'commerceOrder', 'amountCLP', 'currency', 'paymentMethod', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'campaignId', 'engine', 'orderType', 'description', 'commerceOrder', 'amountCLP', 'currency', 'paymentMethod', 'flowToken', 'flowOrder', 'receiptNote', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.engine in ['commercial', 'employment', 'advertising']
        && data.orderType in ['ad_campaign', 'seller_subscription', 'company_subscription', 'featured_post', 'microstore_quota']
        && data.description is string && data.description.size() <= 300
        && data.commerceOrder is string && data.commerceOrder.size() <= 128
        && data.amountCLP is number && data.amountCLP >= 0
        && data.currency == 'CLP'
        && data.paymentMethod in ['flow', 'transfer', 'exempt']
        && data.status in ['pending', 'pending_confirmation', 'confirmed', 'rejected', 'cancelled', 'expired'];
    }

    function isValidReport(data) {
      return data.keys().hasAll(['reporterId', 'targetType', 'targetId', 'module', 'reason', 'details', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['reporterId', 'targetType', 'targetId', 'module', 'reason', 'details', 'status', 'resolutionNote', 'createdAt', 'updatedAt'])
        && isValidId(data.reporterId)
        && data.targetType in ['product', 'vacancy', 'ad', 'user', 'message']
        && data.targetId is string && data.targetId.size() <= 128
        && data.module in ['commercial', 'employment', 'advertising']
        && data.reason is string && data.reason.size() <= 200
        && data.details is string && data.details.size() <= 1500
        && data.status in ['open', 'reviewed', 'dismissed'];
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorUid', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorEmail', 'action', 'targetCollection', 'targetId', 'summary', 'createdAt'])
        && isValidId(data.actorUid)
        && data.action is string && data.action.size() <= 100
        && data.summary is string && data.summary.size() <= 500;
    }

    function isValidMicroStore(data) {
      return data.keys().hasAll(['ownerId', 'storeName', 'description', 'category', 'commune', 'region', 'deliveryOptions', 'acceptedPaymentMethods', 'freeLimit', 'extraQuota', 'maxProductsLimit', 'planPacksCount', 'lastFlowToken', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'storeName', 'description', 'category', 'commune', 'region', 'logoUrl', 'deliveryOptions', 'acceptedPaymentMethods', 'freeLimit', 'extraQuota', 'maxProductsLimit', 'planPacksCount', 'lastFlowToken', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 140
        && data.description is string && data.description.size() <= 1500
        && data.category is string && data.category.size() <= 80
        && data.commune is string && data.commune.size() <= 80
        && data.region is string && data.region.size() <= 80
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 1000))
        && data.deliveryOptions is list && data.deliveryOptions.size() <= 6
        && (data.deliveryOptions.size() == 0 || data.deliveryOptions[0] is string)
        && data.acceptedPaymentMethods is list && data.acceptedPaymentMethods.size() <= 6
        && (data.acceptedPaymentMethods.size() == 0 || data.acceptedPaymentMethods[0] is string)
        && data.freeLimit is number && data.freeLimit == 3
        && data.extraQuota is number && data.extraQuota >= 0 && data.extraQuota <= 500
        && data.maxProductsLimit is number && data.maxProductsLimit == data.freeLimit + data.extraQuota
        && data.planPacksCount is number && data.planPacksCount >= 0 && data.planPacksCount <= 100
        && data.lastFlowToken is string && data.lastFlowToken.size() <= 200
        && data.status in ['active', 'paused'];
    }

    function isValidStoreOrder(data) {
      return data.keys().hasAll(['storeId', 'sellerId', 'sellerName', 'buyerId', 'buyerName', 'buyerCommune', 'items', 'totalCLP', 'buyerNote', 'deliveryType', 'deliveryDetails', 'paymentMethod', 'paymentDetails', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['storeId', 'sellerId', 'sellerName', 'buyerId', 'buyerName', 'buyerCommune', 'items', 'totalCLP', 'buyerNote', 'deliveryType', 'deliveryDetails', 'paymentMethod', 'paymentDetails', 'status', 'createdAt', 'updatedAt'])
        && isValidId(data.storeId)
        && isValidId(data.sellerId)
        && isValidId(data.buyerId)
        && data.sellerName is string && data.sellerName.size() >= 1 && data.sellerName.size() <= 140
        && data.buyerName is string && data.buyerName.size() >= 1 && data.buyerName.size() <= 120
        && data.buyerCommune is string && data.buyerCommune.size() <= 80
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20
        && data.items[0] is map
        && data.totalCLP is number && data.totalCLP >= 0 && data.totalCLP <= 999999999
        && data.buyerNote is string && data.buyerNote.size() <= 500
        && data.deliveryType in ['por_coordinar', 'retiro_tienda', 'despacho_domicilio', 'envio_encomienda']
        && data.deliveryDetails is string && data.deliveryDetails.size() <= 500
