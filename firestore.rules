            && incoming().maxProductsLimit == existing().maxProductsLimit
            && incoming().planPacksCount == existing().planPacksCount
            && incoming().lastFlowToken == existing().lastFlowToken
            && incoming().diff(existing()).affectedKeys().hasOnly(['storeName', 'description', 'category', 'commune', 'region', 'logoUrl', 'deliveryOptions', 'acceptedPaymentMethods', 'status', 'updatedAt'])
          )
          || (
            isOwner(existing().ownerId)
            && (
              isPaymentExempt()
              || (
                incoming().lastFlowToken is string
                && incoming().lastFlowToken.size() >= 10
                && incoming().lastFlowToken != existing().lastFlowToken
              )
            )
            && incoming().extraQuota == existing().extraQuota + 5
            && incoming().maxProductsLimit == existing().freeLimit + incoming().extraQuota
            && incoming().planPacksCount == existing().planPacksCount + 1
            && incoming().diff(existing()).affectedKeys().hasOnly(['extraQuota', 'maxProductsLimit', 'planPacksCount', 'lastFlowToken', 'updatedAt'])
          )
        );
      allow delete: if isValidId(storeId) && (isOwner(existing().ownerId) || isAdmin());
    }

    match /storeOrders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().buyerId == request.auth.uid || existing().sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(orderId)
        && isVerified()
        && isValidStoreOrder(incoming())
        && incoming().buyerId == request.auth.uid
        && incoming().status == 'pending_coordination'
        && incoming().deliveryType == 'por_coordinar'
        && incoming().paymentMethod == 'por_coordinar'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(orderId)
        && isVerified()
        && isValidStoreOrder(incoming())
        && incoming().storeId == existing().storeId
        && incoming().sellerId == existing().sellerId
        && incoming().buyerId == existing().buyerId
        && incoming().items == existing().items
        && incoming().totalCLP == existing().totalCLP
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'completed'
        && existing().status != 'cancelled'
        && (
          isAdmin()
          || (
            isOwner(existing().sellerId)
            && incoming().status in ['pending_coordination', 'coordinated', 'completed', 'cancelled']
            && incoming().diff(existing()).affectedKeys().hasOnly(['deliveryType', 'deliveryDetails', 'paymentMethod', 'paymentDetails', 'status', 'updatedAt'])
          )
          || (
            isOwner(existing().buyerId)
            && existing().status == 'pending_coordination'
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }
  }
}
