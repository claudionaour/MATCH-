# GEMINI_API_KEY: Required for optional server-side AI features if enabled later.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public base URL where MATCH+ is hosted (e.g. https://matchplus.cl or Cloud Run URL).
# Used by Flow webhooks (urlConfirmation) and return URLs (urlReturn).
APP_URL="http://localhost:3000"

# ==============================================================================
# FLOW CHILE - PASARELA DE PAGOS (MATCH ADVERTISING & SUSCRIPCIONES)
# ==============================================================================
# Dónde obtener las credenciales:
# 1. Ambiente de Pruebas (Sandbox): Regístrate en https://sandbox.flow.cl -> Mi Cuenta -> Mis Datos -> Seguridad (ApiKey y SecretKey).
# 2. Ambiente de Producción: Regístrate en https://www.flow.cl -> Completa verificación comercial -> Mi Cuenta -> Seguridad.
# NUNCA expongas FLOW_SECRET_KEY en el frontend (sin prefijo VITE_).
FLOW_ENV="sandbox"
FLOW_API_KEY=""
FLOW_SECRET_KEY=""
FLOW_SANDBOX_URL="https://sandbox.flow.cl/api"
FLOW_PRODUCTION_URL="https://www.flow.cl/api"
